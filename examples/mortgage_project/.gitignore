__pycache__/
*.py[cod]
.venv/
venv/
.env
# Rendered outputs are disposable, but the *.manifest.json files inside are
# receipts — the audit trail. `<dir>/**` with negations (git cannot re-include
# under an excluded directory, so subfolders are re-included first) keeps outputs ignored while the manifests you
# need to stand behind a report stay retained. data/ holds the warehouse and
# `tracebi report build` renders; output/ holds ad-hoc renders.
data/*
!data/*.manifest.json
output/**
!output/**/
!output/**/*.manifest.json
!output/.gitkeep
*.db
.ipynb_checkpoints/
# Workbench dev-state (exhibit feed, pins) — session scratch, never receipts.
.tracebi/
