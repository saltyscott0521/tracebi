{
  "name": "Then vs Now: Buying the Median Home",
  "author": "tracebi reference",
  "description": "What buying the median home took of a household's income over ten years \u2014 the cash to get in plus every payment \u2014 for every buyer since 1979, today's projected, with the worst of the eighties set against today.",
  "measures": {
    "housing_model": {
      "years_in_view": {
        "column": "mortgage_rate", "agg": "count", "format": "comma",
        "description": "Years in view: fact_housing has one row per year"
      }
    }
  },
  "data": {
    "span": {
      "model": "housing_model",
      "query": {
        "fact": "fact_housing",
        "measures": [
          "years_in_view"
        ]
      }
    },
    "peak": {
      "model": "housing_model",
      "query": {
        "fact": "fact_housing",
        "measures": [
          "mortgage_rate",
          "existing_price",
          "median_income",
          "entry_cost",
          "payment",
          "entry_share",
          "payment_share",
          "earner_share"
        ],
        "dimensions": [
          "dim_year.year"
        ],
        "order_by": [
          "-mortgage_rate"
        ],
        "limit": 1
      }
    },
    "latest": {
      "model": "housing_model",
      "query": {
        "fact": "fact_housing",
        "measures": [
          "mortgage_rate",
          "price_to_income",
          "existing_price",
          "median_income",
          "entry_cost",
          "payment",
          "entry_share",
          "payment_share",
          "earner_share"
        ],
        "dimensions": [
          "dim_year.year"
        ],
        "order_by": [
          "-dim_year.year"
        ],
        "limit": 1
      }
    },
    "peak_later": {
      "model": "housing_model",
      "query": {
        "fact": "fact_cohort_path",
        "measures": [
          "payment_share",
          "rate_held"
        ],
        "dimensions": [
          "dim_year.year",
          "dim_cohort.purchase_year"
        ],
        "filters": {
          "dim_cohort.purchase_year": 1981,
          "dim_held.years_owned": 9
        }
      }
    },
    "paths": {
      "model": "housing_model",
      "query": {
        "fact": "fact_cohort_path",
        "measures": [
          "payment_share"
        ],
        "dimensions": [
          "dim_held.years_owned",
          "dim_cohort.purchase_year"
        ],
        "filters": {
          "dim_cohort.purchase_year": {
            "in": [
              1981,
              2006,
              2023
            ]
          }
        },
        "order_by": [
          "dim_held.years_owned",
          "dim_cohort.purchase_year"
        ]
      }
    },
    "ten_year": {
      "model": "housing_model",
      "query": {
        "fact": "fact_ten_year",
        "measures": [
          "housing_share"
        ],
        "dimensions": [
          "dim_cohort.purchase_year",
          "dim_cohort.basis"
        ],
        "order_by": [
          "dim_cohort.purchase_year"
        ]
      }
    },
    "ten_today": {
      "model": "housing_model",
      "query": {
        "fact": "fact_ten_year",
        "measures": [
          "housing_share",
          "years_measured"
        ],
        "dimensions": [
          "dim_cohort.purchase_year",
          "dim_cohort.basis"
        ],
        "order_by": [
          "-dim_cohort.purchase_year"
        ],
        "limit": 1
      }
    },
    "projection": {
      "model": "housing_model",
      "query": {
        "fact": "fact_ten_year",
        "measures": [
          "rate_at_purchase",
          "price_at_purchase",
          "income_at_purchase",
          "assumed_rate",
          "growth_pct"
        ],
        "dimensions": [
          "dim_cohort.purchase_year"
        ],
        "order_by": [
          "-dim_cohort.purchase_year"
        ],
        "limit": 1
      }
    },
    "history": {
      "model": "housing_model",
      "query": {
        "fact": "fact_housing",
        "measures": [
          "mortgage_rate",
          "price_to_income",
          "payment_share"
        ],
        "dimensions": [
          "dim_year.year"
        ],
        "order_by": [
          "dim_year.year"
        ]
      }
    },
    "ten_best": {
      "model": "housing_model",
      "query": {
        "fact": "fact_ten_year",
        "measures": [
          "housing_share"
        ],
        "dimensions": [
          "dim_cohort.purchase_year",
          "dim_cohort.basis"
        ],
        "filters": {
          "dim_cohort.basis": "measured"
        },
        "order_by": [
          "housing_share"
        ],
        "limit": 1
      }
    },
    "ten_worst": {
      "model": "housing_model",
      "query": {
        "fact": "fact_ten_year",
        "measures": [
          "housing_share"
        ],
        "dimensions": [
          "dim_cohort.purchase_year",
          "dim_cohort.basis"
        ],
        "filters": {
          "dim_cohort.basis": "measured"
        },
        "order_by": [
          "-housing_share"
        ],
        "limit": 1
      }
    }
  }
}
