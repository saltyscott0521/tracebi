{
  "name": "Portfolio Desk",
  "author": "workflow",
  "description": "Fair value, unrealized gain, mark and weighted spread for the book, with a watch list of the lowest marks, searchable holdings and the funds side by side.",
  "notes": "An app people work in: a sidebar with three views.",
  "theme": "nightdesk",
  "look": {"density": "compact"},
  "data": {
    "totals": {
      "model": "portfolio_model",
      "query": {"fact": "fact_holdings",
                "measures": ["fair_value", "unrealized", "mark", "positions", "wtd_spread_bps"]}
    },
    "weakest_fund": {
      "model": "portfolio_model",
      "query": {"fact": "fact_holdings", "measures": ["mark"],
                "dimensions": ["dim_fund.fund"], "order_by": ["mark"], "limit": 1}
    },
    "funds_in_view": {
      "model": "portfolio_model",
      "query": {"fact": "fact_holdings",
                "measures": {"funds": {"expr": "fund_id", "agg": "nunique"}}}
    },
    "by_sector": {
      "model": "portfolio_model",
      "query": {"fact": "fact_holdings", "measures": ["fair_value", "unrealized"],
                "dimensions": ["dim_issuer.sector"], "order_by": ["-fair_value"]}
    },
    "watch": {
      "model": "portfolio_model",
      "query": {"fact": "fact_holdings", "measures": ["mark", "unrealized"],
                "dimensions": ["dim_issuer.issuer"], "order_by": ["mark"], "limit": 5}
    },
    "holdings": {
      "model": "portfolio_model",
      "query": {"fact": "fact_holdings",
                "measures": ["fair_value", "unrealized", "mark", "wtd_spread_bps"],
                "dimensions": ["dim_issuer.issuer", "dim_issuer.sector", "dim_fund.fund"],
                "order_by": ["-fair_value"]}
    },
    "by_fund": {
      "model": "portfolio_model",
      "query": {"fact": "fact_holdings",
                "measures": ["fair_value", "unrealized", "mark", "positions", "wtd_spread_bps"],
                "dimensions": ["dim_fund.fund"], "order_by": ["-fair_value"]}
    },
    "fund_sector": {
      "model": "portfolio_model",
      "query": {"fact": "fact_holdings", "measures": ["fair_value"],
                "dimensions": ["dim_fund.fund", "dim_issuer.sector"],
                "order_by": ["dim_fund.fund", "dim_issuer.sector"]}
    }
  }
}
