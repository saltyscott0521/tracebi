{
  "name": "Portfolio Overview",
  "description": "The book at a glance: fair value, mark and unrealized gain, fair value by sector, the eight largest issuers, and the funds compared.",
  "data": {
    "kpis": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": [
          "fair_value",
          "positions",
          "mark",
          "unrealized",
          "cost_basis"
        ]
      }
    },
    "by_sector": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": [
          "fair_value"
        ],
        "dimensions": [
          "dim_issuer.sector"
        ],
        "order_by": [
          "-fair_value"
        ]
      }
    },
    "top_issuers": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": [
          "fair_value",
          "cost_basis",
          "mark"
        ],
        "dimensions": [
          "dim_issuer.issuer"
        ],
        "order_by": [
          "-fair_value"
        ],
        "limit": 8
      }
    },
    "by_fund": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": [
          "fair_value",
          "mark"
        ],
        "dimensions": [
          "dim_fund.fund"
        ],
        "order_by": [
          "-fair_value"
        ]
      }
    }
  }
}
