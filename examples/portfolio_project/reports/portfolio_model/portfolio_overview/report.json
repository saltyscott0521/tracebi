{
  "name": "portfolio_overview",
  "description": "The book at a glance, as an app with top tabs: an overview with the KPI strip and the sector chart, the eight largest issuers, and the funds. Every number is a kit figure.",
  "data": {
    "kpis": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": [
          "fair_value",
          "positions",
          "mark",
          "unrealized"
        ]
      }
    },
    "by_sector": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": [
          "fair_value"
        ],
        "dimensions": [
          "dim_issuer.sector"
        ],
        "order_by": [
          "-fair_value"
        ]
      }
    },
    "top_issuers": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": [
          "fair_value",
          "cost_basis",
          "mark"
        ],
        "dimensions": [
          "dim_issuer.issuer"
        ],
        "order_by": [
          "-fair_value"
        ],
        "limit": 8
      }
    },
    "by_fund": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": [
          "fair_value",
          "mark"
        ],
        "dimensions": [
          "dim_fund.fund"
        ],
        "order_by": [
          "-fair_value"
        ]
      }
    }
  }
}
