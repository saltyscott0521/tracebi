{
  "name": "portfolio_overview",
  "description": "The default stack, end to end: a title block, a KPI strip with a lead, a wide chart beside a narrow ranking, and a table, all hydrated by the shipped runtime from the stamped bytes. No author CSS or JS.",
  "data": {
    "kpis": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": [
          "fair_value",
          "positions",
          "mark",
          "unrealized"
        ]
      }
    },
    "by_sector": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": [
          "fair_value"
        ],
        "dimensions": [
          "dim_issuer.sector"
        ],
        "order_by": [
          "-fair_value"
        ]
      }
    },
    "top_issuers": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": [
          "fair_value",
          "cost_basis",
          "mark"
        ],
        "dimensions": [
          "dim_issuer.issuer"
        ],
        "order_by": [
          "-fair_value"
        ],
        "limit": 8
      }
    },
    "by_fund": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": [
          "fair_value",
          "mark"
        ],
        "dimensions": [
          "dim_fund.fund"
        ],
        "order_by": [
          "-fair_value"
        ]
      }
    }
  }
}
