{
  "name": "Portfolio Concentration",
  "author": "risk",
  "description": "How concentrated the book is: each issuer's rank, share of fair value and cumulative share, and the five largest issuers' combined share.",
  "notes": "Rank, share and cumulative share are governed window measures (rank, share, running) declared in the model, so every number re-runs with tracebi verify. The headline's top-five share is the fifth issuer's row, picked by a having clause.",
  "data": {
    "fifth": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": [
          "fv_rank",
          "fv_cum_share"
        ],
        "dimensions": [
          "dim_issuer.issuer"
        ],
        "having": {
          "fv_rank": 5
        }
      }
    },
    "largest": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": [
          "fv_rank",
          "fv_share",
          "fair_value"
        ],
        "dimensions": [
          "dim_issuer.issuer"
        ],
        "having": {
          "fv_rank": 1
        }
      }
    },
    "largest_sector": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": [
          "fv_share"
        ],
        "dimensions": [
          "dim_issuer.sector"
        ],
        "order_by": [
          "-fv_share"
        ],
        "limit": 1
      }
    },
    "concentration": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": [
          "fv_rank",
          "fair_value",
          "fv_share",
          "fv_cum_share"
        ],
        "dimensions": [
          "dim_issuer.issuer",
          "dim_issuer.sector"
        ],
        "order_by": [
          {
            "column": "fv_rank",
            "desc": false
          }
        ]
      }
    }
  }
}
