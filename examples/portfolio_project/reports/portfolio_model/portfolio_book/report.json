{
  "name": "Portfolio Book",
  "author": "workflow",
  "description": "A written review of the book: how it is marked against cost, which sectors carry the loss, the weakest fund and issuer, and the largest issuers.",
  "notes": "An editorial page with its own house CSS; the issuer table is drawn by script.js from the same rows. The sector and fund filters re-run every figure, the prose included.",
  "data": {
    "totals": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": ["fair_value", "cost_basis", "unrealized", "mark", "positions"]
      }
    },
    "by_sector": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": ["fair_value"],
        "dimensions": ["dim_issuer.sector"],
        "order_by": [{"column": "fair_value", "desc": true}]
      }
    },
    "largest_sector": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": ["fv_share"],
        "dimensions": ["dim_issuer.sector"],
        "order_by": ["-fv_share"],
        "limit": 1
      }
    },
    "lowest_sector": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": ["mark"],
        "dimensions": ["dim_issuer.sector"],
        "order_by": ["mark"],
        "limit": 1
      }
    },
    "sector_marks": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": ["unrealized", "mark", "fair_value"],
        "dimensions": ["dim_issuer.sector"],
        "order_by": ["unrealized"]
      }
    },
    "weakest_fund": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": ["mark", "unrealized"],
        "dimensions": ["dim_fund.fund"],
        "order_by": ["mark"],
        "limit": 1
      }
    },
    "lowest_mark": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": ["mark", "unrealized"],
        "dimensions": ["dim_issuer.issuer"],
        "order_by": ["mark"],
        "limit": 1
      }
    },
    "top_issuers": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": ["fair_value", "positions"],
        "dimensions": ["dim_issuer.issuer"],
        "order_by": ["-fair_value"],
        "limit": 10
      }
    }
  }
}
