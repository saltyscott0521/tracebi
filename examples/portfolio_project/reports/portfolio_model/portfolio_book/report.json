{
  "name": "Portfolio Book",
  "author": "workflow",
  "description": "The direct-lending book as an editorial report: the headline is the finding, every number in the prose is a bound figure, and the page carries its own house CSS and a script-drawn issuer table (script.js) from the same fingerprinted data.",
  "data": {
    "totals": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": ["fair_value", "cost_basis", "unrealized", "mark", "positions"]
      }
    },
    "by_sector": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": ["fair_value"],
        "dimensions": ["dim_issuer.sector"],
        "order_by": [{"column": "fair_value", "desc": true}]
      }
    },
    "sector_marks": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": ["unrealized", "mark", "fair_value"],
        "dimensions": ["dim_issuer.sector"],
        "order_by": ["unrealized"]
      }
    },
    "weakest_fund": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": ["mark", "unrealized"],
        "dimensions": ["dim_fund.fund"],
        "order_by": ["mark"],
        "limit": 1
      }
    },
    "lowest_mark": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": ["mark", "unrealized"],
        "dimensions": ["dim_issuer.issuer"],
        "order_by": ["mark"],
        "limit": 1
      }
    },
    "top_issuers": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": ["fair_value", "positions"],
        "dimensions": ["dim_issuer.issuer"]
      }
    }
  }
}
