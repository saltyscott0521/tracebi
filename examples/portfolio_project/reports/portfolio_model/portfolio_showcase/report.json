{
  "name": "Portfolio Showcase",
  "author": "tracebi reference",
  "description": "Fair value, unrealized gain, mark and spread for the book, by sector, fund, rating and issuer, with how concentrated it is, every holding, and the cash that moved.",
  "notes": "The maintained kitchen-sink demo of the app lane: every kit figure, control, gesture and trust affordance, on the reference data, as a product.",
  "theme": "signal",
  "embed": "required",
  "embed_budget_mb": 25,
  "data": {
    "kpis": {
      "model": "portfolio_model",
      "query": { "fact": "fact_holdings",
                 "measures": ["fair_value", "unrealized", "mark", "positions", "wtd_spread_bps", "spread_p90"] }
    },
    "top_sector": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings", "measures": ["fair_value", "fv_share"],
        "dimensions": ["dim_issuer.sector"], "order_by": ["-fair_value"], "limit": 1
      }
    },
    "top_issuer": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings", "measures": ["fair_value", "fv_share"],
        "dimensions": ["dim_issuer.issuer"], "order_by": ["-fair_value"], "limit": 1
      }
    },
    "by_sector": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings", "measures": ["fair_value", "unrealized", "mark", "positions"],
        "dimensions": ["dim_issuer.sector"], "order_by": ["-fair_value"]
      }
    },
    "by_fund": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings", "measures": ["fair_value", "unrealized", "mark", "positions"],
        "dimensions": ["dim_fund.fund"], "order_by": ["-fair_value"]
      }
    },
    "fund_sector": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings", "measures": ["fair_value"],
        "dimensions": ["dim_fund.fund", "dim_issuer.sector"],
        "order_by": ["dim_fund.fund", "dim_issuer.sector"]
      }
    },
    "by_rating": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings", "measures": ["fair_value", "positions", "wtd_spread_bps", "mark"],
        "dimensions": ["dim_rating.rating"], "order_by": ["dim_rating.rating"]
      }
    },
    "rating_watch": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings", "measures": ["fair_value"],
        "dimensions": ["dim_rating.rating", "dim_rating.watch"],
        "order_by": ["dim_rating.rating", "dim_rating.watch"]
      }
    },
    "watched": {
      "model": "portfolio_model",
      "query": { "fact": "fact_holdings", "measures": ["fair_value", "positions"],
                 "filters": {"dim_rating.watch": "yes"} }
    },
    "holdings_detail": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": ["fair_value", "cost_basis", "unrealized", "mark", "wtd_spread_bps"],
        "dimensions": ["dim_issuer.issuer", "dim_issuer.sector", "dim_rating.rating"],
        "order_by": ["-fair_value"]
      }
    },
    "holdings_total": {
      "model": "portfolio_model",
      "query": { "fact": "fact_holdings",
                 "measures": ["fair_value", "cost_basis", "unrealized", "mark", "wtd_spread_bps"] }
    },
    "issuer_fv": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings", "measures": ["fair_value", "mark", "wtd_spread_bps"],
        "dimensions": ["dim_issuer.issuer"], "order_by": ["-fair_value"]
      }
    },
    "issuer_curve": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings", "measures": ["fv_rank", "fv_cum_share"],
        "dimensions": ["dim_issuer.issuer"],
        "order_by": [{"column": "fv_rank", "desc": false}]
      }
    },
    "top_issuers": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings", "measures": ["fair_value", "fv_share", "mark"],
        "dimensions": ["dim_issuer.issuer"],
        "order_by": ["-fair_value"], "limit": 8
      }
    },
    "flows": {
      "model": "portfolio_model",
      "query": { "fact": "fact_cashflows", "measures": ["net_flow", "flow_count"] }
    },
    "flows_by_month": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_cashflows", "measures": ["net_flow", "flow_count"],
        "dimensions": ["dim_date.month"], "order_by": ["dim_date.month"]
      }
    },
    "flows_by_type": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_cashflows", "measures": ["net_flow", "flow_count"],
        "dimensions": ["dim_flow_type.flow_type"], "order_by": ["-net_flow"]
      }
    },
    "flows_by_fund": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_cashflows", "measures": ["net_flow", "flow_count"],
        "dimensions": ["dim_fund.fund", "dim_flow_type.flow_type"],
        "order_by": ["dim_fund.fund", "dim_flow_type.flow_type"]
      }
    }
  },
  "selection": {
    "model": "portfolio_model",
    "filters": {}
  },
  "schedule": {
    "cron": "0 7 * * MON",
    "timezone": "America/New_York",
    "refresh": {"transforms": ["holdings_transform"]}
  }
}
