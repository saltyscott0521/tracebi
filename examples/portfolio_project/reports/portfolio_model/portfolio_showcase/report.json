{
  "name": "Portfolio Showcase",
  "author": "tracebi reference",
  "description": "Fair value, mark and unrealized gain by sector, fund and issuer, with how concentrated the book is and every holding.",
  "notes": "The maintained kitchen-sink demo: every figure kind, control, layout and trust affordance the artifact offers, on the reference data.",
  "libs": ["d3"],
  "data": {
    "kpis": {
      "model": "portfolio_model",
      "query": { "fact": "fact_holdings", "measures": ["fair_value", "positions", "mark"] }
    },
    "by_sector": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings", "measures": ["fair_value"],
        "dimensions": ["dim_issuer.sector"], "order_by": ["-fair_value"]
      }
    },
    "top_sector": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings", "measures": ["fair_value", "fv_share"],
        "dimensions": ["dim_issuer.sector"], "order_by": ["-fair_value"], "limit": 1
      }
    },
    "gain": {
      "model": "portfolio_model",
      "query": { "fact": "fact_holdings", "measures": ["unrealized"] }
    },
    "by_fund": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings", "measures": ["fair_value"],
        "dimensions": ["dim_fund.fund"], "order_by": ["-fair_value"]
      }
    },
    "fund_sector": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings", "measures": ["fair_value"],
        "dimensions": ["dim_fund.fund", "dim_issuer.sector"],
        "order_by": ["dim_issuer.sector"]
      }
    },
    "holdings_detail": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings",
        "measures": ["fair_value", "cost_basis", "mark"],
        "dimensions": ["dim_issuer.issuer", "dim_issuer.sector"],
        "order_by": ["-fair_value"]
      }
    },
    "holdings_total": {
      "model": "portfolio_model",
      "query": { "fact": "fact_holdings", "measures": ["fair_value", "cost_basis", "mark"] }
    },
    "issuer_curve": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings", "measures": ["fv_rank", "fv_cum_share"],
        "dimensions": ["dim_issuer.issuer"],
        "order_by": [{"column": "fv_rank", "desc": false}]
      }
    },
    "top_issuers": {
      "model": "portfolio_model",
      "query": {
        "fact": "fact_holdings", "measures": ["fair_value", "mark"],
        "dimensions": ["dim_issuer.issuer"],
        "order_by": ["-fair_value"], "limit": 8
      }
    }
  },
  "selection": {
    "model": "portfolio_model",
    "filters": {}
  },
  "schedule": {
    "cron": "0 7 * * MON",
    "timezone": "America/New_York",
    "refresh": {"transforms": ["holdings_transform"]}
  },
  "figures": {
    "chart_fund": {
      "kind": "chart", "binding": "by_fund", "chart_type": "pie",
      "x": "dim_fund.fund", "y": "fair_value", "value_format": "compact"
    }
  }
}
