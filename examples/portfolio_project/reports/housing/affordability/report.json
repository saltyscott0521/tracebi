{
  "name": "Then vs Now: Buying the Median Home",
  "author": "tracebi reference",
  "description": "Getting in and carrying the payment on the median existing home, every year since 1979: the worst year of the eighties against today, what each year's buyer paid ten years on, and a scenario to try your own numbers.",
  "libs": [
    "echarts"
  ],
  "data": {
    "history": {
      "model": "housing_model",
      "query": {
        "fact": "fact_housing",
        "measures": [
          "mortgage_rate",
          "existing_price",
          "new_home_price",
          "median_income",
          "earner_income",
          "entry_cost",
          "payment",
          "entry_share",
          "payment_share",
          "earner_share",
          "pi_share",
          "price_to_income"
        ],
        "dimensions": [
          "dim_year.year"
        ],
        "order_by": [
          "dim_year.year"
        ]
      }
    },
    "compare": {
      "model": "housing_model",
      "query": {
        "fact": "fact_housing",
        "measures": [
          "mortgage_rate",
          "existing_price",
          "price_to_income",
          "entry_share",
          "payment_share",
          "earner_share",
          "pi_share"
        ],
        "dimensions": [
          "dim_year.year"
        ],
        "filters": {
          "dim_year.year": {
            "in": [
              1981,
              2025
            ]
          }
        },
        "order_by": [
          "dim_year.year"
        ]
      }
    },
    "peak": {
      "model": "housing_model",
      "query": {
        "fact": "fact_housing",
        "measures": [
          "mortgage_rate",
          "existing_price",
          "median_income",
          "entry_cost",
          "payment",
          "entry_share",
          "payment_share",
          "earner_share"
        ],
        "dimensions": [
          "dim_year.year"
        ],
        "filters": {
          "dim_year.year": 1981
        }
      }
    },
    "latest": {
      "model": "housing_model",
      "query": {
        "fact": "fact_housing",
        "measures": [
          "mortgage_rate",
          "existing_price",
          "median_income",
          "entry_cost",
          "payment",
          "entry_share",
          "payment_share",
          "earner_share"
        ],
        "dimensions": [
          "dim_year.year"
        ],
        "order_by": [
          "-dim_year.year"
        ],
        "limit": 1
      }
    },
    "peak_later": {
      "model": "housing_model",
      "query": {
        "fact": "fact_cohort_path",
        "measures": [
          "payment_share",
          "rate_held"
        ],
        "dimensions": [
          "dim_year.year"
        ],
        "filters": {
          "dim_cohort.purchase_year": 1981,
          "dim_held.years_owned": 10
        }
      }
    },
    "paths": {
      "model": "housing_model",
      "query": {
        "fact": "fact_cohort_path",
        "measures": [
          "payment_share"
        ],
        "dimensions": [
          "dim_held.years_owned",
          "dim_cohort.purchase_year"
        ],
        "filters": {
          "dim_cohort.purchase_year": {
            "in": [
              1981,
              2006,
              2023
            ]
          }
        },
        "order_by": [
          "dim_cohort.purchase_year",
          "dim_held.years_owned"
        ]
      }
    },
    "hardest_carry": {
      "model": "housing_model",
      "query": {
        "fact": "fact_housing",
        "measures": [
          "payment_share",
          "mortgage_rate"
        ],
        "dimensions": [
          "dim_year.year"
        ],
        "order_by": [
          "-payment_share"
        ],
        "limit": 1
      }
    },
    "hardest_entry": {
      "model": "housing_model",
      "query": {
        "fact": "fact_housing",
        "measures": [
          "entry_share",
          "price_to_income"
        ],
        "dimensions": [
          "dim_year.year"
        ],
        "order_by": [
          "-entry_share"
        ],
        "limit": 1
      }
    },
    "ten_year": {
      "model": "housing_model",
      "query": {
        "fact": "fact_cohort_path",
        "measures": [
          "housing_share"
        ],
        "dimensions": [
          "dim_cohort.purchase_year"
        ],
        "filters": {
          "dim_held.years_owned": {
            "lte": 9
          },
          "dim_cohort.years_followed": {
            "gte": 9
          }
        },
        "order_by": [
          "dim_cohort.purchase_year"
        ]
      }
    },
    "ten_peak": {
      "model": "housing_model",
      "query": {
        "fact": "fact_cohort_path",
        "measures": [
          "housing_share"
        ],
        "dimensions": [
          "dim_cohort.purchase_year"
        ],
        "filters": {
          "dim_held.years_owned": {
            "lte": 9
          },
          "dim_cohort.years_followed": {
            "gte": 9
          },
          "dim_cohort.purchase_year": 1981
        }
      }
    },
    "ten_worst": {
      "model": "housing_model",
      "query": {
        "fact": "fact_cohort_path",
        "measures": [
          "housing_share"
        ],
        "dimensions": [
          "dim_cohort.purchase_year"
        ],
        "filters": {
          "dim_held.years_owned": {
            "lte": 9
          },
          "dim_cohort.years_followed": {
            "gte": 9
          }
        },
        "order_by": [
          "-housing_share"
        ],
        "limit": 1
      }
    },
    "ten_best": {
      "model": "housing_model",
      "query": {
        "fact": "fact_cohort_path",
        "measures": [
          "housing_share"
        ],
        "dimensions": [
          "dim_cohort.purchase_year"
        ],
        "filters": {
          "dim_held.years_owned": {
            "lte": 9
          },
          "dim_cohort.years_followed": {
            "gte": 9
          }
        },
        "order_by": [
          "housing_share"
        ],
        "limit": 1
      }
    }
  }
}
