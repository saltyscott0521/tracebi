{
  "name": "SaaS Cohort Brief",
  "author": "tracebi init --template saas-metrics",
  "description": "Which signup cohort holds the most ending MRR, where logo churn sits, and ending MRR, customers and churn month by month.",
  "data": {
    "kpis": {
      "model": "saas_model",
      "query": {
        "fact": "fact_account_month",
        "measures": [
          "ending_mrr",
          "customers",
          "logo_churn"
        ]
      }
    },
    "top_cohort": {
      "model": "saas_model",
      "query": {
        "fact": "fact_account_month",
        "measures": [
          "ending_mrr",
          "customers"
        ],
        "dimensions": [
          "dim_cohort.cohort"
        ],
        "order_by": [
          "-ending_mrr"
        ],
        "limit": 1
      }
    },
    "by_cohort": {
      "model": "saas_model",
      "query": {
        "fact": "fact_account_month",
        "measures": [
          "ending_mrr",
          "customers",
          "logo_churn"
        ],
        "dimensions": [
          "dim_cohort.cohort"
        ],
        "order_by": [
          "dim_cohort.cohort"
        ]
      }
    },
    "by_month": {
      "model": "saas_model",
      "query": {
        "fact": "fact_account_month",
        "measures": [
          "ending_mrr",
          "customers",
          "logo_churn"
        ],
        "dimensions": [
          "dim_month.month"
        ],
        "order_by": [
          "dim_month.month"
        ]
      }
    },
    "churniest": {
      "model": "saas_model",
      "query": {
        "fact": "fact_account_month",
        "measures": [
          "logo_churn"
        ],
        "dimensions": [
          "dim_cohort.cohort"
        ],
        "order_by": [
          "-logo_churn"
        ],
        "limit": 1
      }
    }
  }
}
