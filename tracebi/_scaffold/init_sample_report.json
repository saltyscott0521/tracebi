{
  "name": "Sample Dashboard",
  "author": "tracebi init",
  "description": "Revenue, orders and units by region, and how much of revenue comes from big orders.",
  "measures": {
    "sample_model": {
      "big_orders": {
        "column": "revenue",
        "agg": "sum",
        "filters": {
          "qty": {
            "gte": 10
          }
        },
        "format": "currency0"
      },
      "small_orders": {
        "column": "revenue",
        "agg": "sum",
        "filters": {
          "qty": {
            "lt": 10
          }
        },
        "format": "currency0"
      },
      "big_minus_small": {
        "measure_expr": "big_orders - small_orders",
        "format": "currency0"
      }
    }
  },
  "data": {
    "split": {
      "model": "sample_model",
      "query": {
        "fact": "fact_orders",
        "measures": [
          "big_minus_small",
          "big_orders",
          "small_orders"
        ]
      }
    },
    "kpis": {
      "model": "sample_model",
      "query": {
        "fact": "fact_orders",
        "measures": [
          "revenue",
          "orders",
          "units"
        ]
      }
    },
    "top_region": {
      "model": "sample_model",
      "query": {
        "fact": "fact_orders",
        "measures": [
          "revenue"
        ],
        "dimensions": [
          "dim_region.region"
        ],
        "order_by": [
          "-revenue"
        ],
        "limit": 1
      }
    },
    "by_region": {
      "model": "sample_model",
      "query": {
        "fact": "fact_orders",
        "measures": [
          "revenue"
        ],
        "dimensions": [
          "dim_region.region"
        ],
        "having": {
          "revenue": {
            "gte": 1000
          }
        },
        "order_by": [
          "-revenue"
        ]
      }
    },
    "region_detail": {
      "model": "sample_model",
      "query": {
        "fact": "fact_orders",
        "measures": [
          "revenue",
          "orders",
          "units"
        ],
        "dimensions": [
          "dim_region.region"
        ],
        "order_by": [
          "-revenue"
        ]
      }
    }
  }
}
