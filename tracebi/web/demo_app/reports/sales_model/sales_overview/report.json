{
  "name": "Sales Overview",
  "author": "TraceBi Demo",
  "description": "Revenue, units and cost by region and customer segment, straight off the sales model: an app (app.jsx) whose every number is a kit figure.",
  "data": {
    "totals": {"model": "sales_model", "query": {"fact": "fact_orders",
      "measures": {"revenue": "sum", "qty": "sum", "cost": "sum"}}},
    "by_region": {"model": "sales_model", "query": {"fact": "fact_orders",
      "measures": {"revenue": "sum"}, "dimensions": ["dim_customer.region"],
      "order_by": ["-revenue"]}},
    "top_region": {"model": "sales_model", "query": {"fact": "fact_orders",
      "measures": {"revenue": "sum"}, "dimensions": ["dim_customer.region"],
      "order_by": ["-revenue"], "limit": 1}},
    "by_segment": {"model": "sales_model", "query": {"fact": "fact_orders",
      "measures": {"revenue": "sum", "qty": "sum", "cost": "sum"},
      "dimensions": ["dim_customer.segment"], "order_by": ["-revenue"]}}
  }
}
