__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
# Rendered outputs are disposable, but *.manifest.json files are receipts —
# the audit trail behind every rendered number. `output/*` + the negation
# (not `output/`: git cannot re-include files under an excluded directory)
# keeps outputs ignored while manifests stay retained.
output/*
!output/*.manifest.json
.DS_Store
.ipynb_checkpoints/
*.ipynb
test_output.html
data/
.claude/

# Local environment / secrets — never commit these.
.env
.env.local
.env.*.local
*.db
*.sqlite
*.sqlite3

web/ui/node_modules/
# vite's build.outDir writes the bundle into the Python package so the wheel
# can carry it; the build output is still disposable and stays untracked.
tracebi/web/ui/dist/

# Three-phase workflow — the warehouse and rendered output are build artifacts
# under data/ (already ignored above). Raw pulls live in inputs/ (tracked; a
# large or sensitive real pull can be ignored per-file).
